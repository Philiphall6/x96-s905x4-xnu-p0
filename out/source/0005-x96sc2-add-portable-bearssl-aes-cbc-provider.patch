index 20ff4f1..8747523 100644
--- a/libkern/crypto/corecrypto_aes.c
+++ b/libkern/crypto/corecrypto_aes.c
@@ -32,10 +32,20 @@
 #include <corecrypto/ccaes.h>
 #include <kern/debug.h>
 
+#if defined(ARM64_BOARD_CONFIG_X96SC2)
