From 30ca28345d34856bcdf0382494a7e2b0caf3bf76 Mon Sep 17 00:00:00 2001
From: X96 XNU Port <x96-xnu-local@localhost>
Date: Wed, 21 Oct 2026 05:05:04 +0000
Subject: [PATCH] x96sc2: use built-in SHA-256 for libkern

---
 libkern/crypto/corecrypto_sha2.c | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/libkern/crypto/corecrypto_sha2.c b/libkern/crypto/corecrypto_sha2.c
index 7392f0c..01ee070 100644
--- a/libkern/crypto/corecrypto_sha2.c
+++ b/libkern/crypto/corecrypto_sha2.c
@@ -34,34 +34,46 @@
 
 #if defined(CRYPTO_SHA2)
 
+#if defined(ARM64_BOARD_CONFIG_X96SC2)
+/* X96SC2 uses the SHA-256 implementation already built into this kernel. */
+#include <corecrypto/ccsha2.h>
+#define X96_SHA256_DI()                    (&ccsha256_ltc_di)
+#define X96_SHA256_INIT(di, ctx)           ccdigest_init(di, ctx)
+#define X96_SHA256_UPDATE(di, ctx, n, src) ccdigest_update(di, ctx, n, src)
+#else
+#define X96_SHA256_DI()                    (g_crypto_funcs->ccsha256_di)
+#define X96_SHA256_INIT(di, ctx)           g_crypto_funcs->ccdigest_init_fn(di, ctx)
+#define X96_SHA256_UPDATE(di, ctx, n, src) g_crypto_funcs->ccdigest_update_fn(di, ctx, n, src)
+#endif
+
 void
 SHA256_Init(SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = X96_SHA256_DI();
 
 	/* Make sure the context size for the digest info fits in the one we have */
 	if (ccdigest_di_size(di) > sizeof(SHA256_CTX)) {
 		panic("%s: inconsistent size for SHA256 context", __FUNCTION__);
 	}
 
-	g_crypto_funcs->ccdigest_init_fn(di, ctx->ctx);
+	X96_SHA256_INIT(di, ctx->ctx);
 }
 
 void
 SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = X96_SHA256_DI();
 
-	g_crypto_funcs->ccdigest_update_fn(di, ctx->ctx, len, data);
+	X96_SHA256_UPDATE(di, ctx->ctx, len, data);
 }
 
 void
 SHA256_Final(void *digest, SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = X96_SHA256_DI();
 
 	ccdigest_final(di, ctx->ctx, digest);
 }
