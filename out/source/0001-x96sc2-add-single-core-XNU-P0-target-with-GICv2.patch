diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
new file mode 100644
index 0000000..444e536
--- /dev/null
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -0,0 +1,83 @@
+/*
+ * Board config for the Redmi Note 10 Pro ("sweet", Qualcomm SM7150 /
+ * Snapdragon 732G): Kryo 470 = Cortex-A76 + Cortex-A55, ARMv8.2, no PAC.
+ *
+ * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
+ * implementation-defined system registers exist), 16K pages and GICv3 like
+ * VMAPPLE. Unlike VMAPPLE the GIC has two security states (GICD_TYPER
+ * SecurityExtn=1): Group 0 belongs to TrustZone, so every interrupt,
+ * including the timer, is a Group 1 IRQ taken through sleh_irq().
+ */
+
+#ifndef _PEXPERT_ARM64_SWEET_H
+#define _PEXPERT_ARM64_SWEET_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define SWEET                     1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
+ * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
+ * (CNTV) is INTID 16 + 3 = 19.
+ */
+#define SWEET_VTIMER_INTID        19
+#define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
+
+/* Bootloader framebuffer kept alive for the allocation-free early console. */
+#define SWEET_EARLY_FB_PHYS       0x9c000000
+#define SWEET_EARLY_FB_L2_PHYS    0x9c000000
+#define SWEET_EARLY_FB_WIDTH      1080
+#define SWEET_EARLY_FB_HEIGHT     2400
+#define SWEET_EARLY_FB_STRIDE     4320
+#define SWEET_FBCON_NODE_NAME     "sweet-fbcon"
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_SWEET_H */
diff --git a/pexpert/pexpert/arm64/X96SC2.h b/pexpert/pexpert/arm64/X96SC2.h
new file mode 100644
index 0000000..4d769c4
--- /dev/null
+++ b/pexpert/pexpert/arm64/X96SC2.h
@@ -0,0 +1,70 @@
+/*
+ * Board configuration for X96 Max+ Ultra (Amlogic S905X4 / SC2).
+ *
+ * The Cortex-A55 cluster is generic ARMv8.2 without Apple implementation-
+ * defined registers or pointer authentication. The board exposes a GIC-400
+ * (GICv2), PSCI through SMC and supports the 16 KiB translation granule XNU
+ * 8796 expects for this bring-up configuration.
+ */
+
+#ifndef _PEXPERT_ARM64_X96SC2_H
+#define _PEXPERT_ARM64_X96SC2_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+/* Reuse the generic non-Apple compatibility work from the SWEET patch set. */
+#define SWEET                     1
+#define X96SC2                    1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V2                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+#define X96SC2_VTIMER_INTID       27
+#define X96SC2_IPI_SGI            1
+#define GIC_SPURIOUS_IRQ          1023
+
+/*
+ * Provisional U-Boot logo buffer from the known-good SlimBOX device tree.
+ * The 16 KiB translation granule maps it through a 32 MiB L2 block whose
+ * physical base must be aligned independently from the buffer itself.
+ */
+#define SWEET_EARLY_FB_PHYS       0xdf800000
+#define SWEET_EARLY_FB_L2_PHYS    0xde000000
+#define SWEET_EARLY_FB_WIDTH      1920
+#define SWEET_EARLY_FB_HEIGHT     1080
+#define SWEET_EARLY_FB_STRIDE     7680
+#define SWEET_FBCON_NODE_NAME     "x96-fbcon"
+
+/* GIC-400 distributor registers. */
+#define GICD_CTLR                 0x000
+#define GICD_IGROUPR0             0x080
+#define GICD_ISENABLER0           0x100
+#define GICD_IPRIORITYR0          0x400
+#define GICD_SGIR                 0xF00
+
+/* GIC-400 CPU interface registers. */
+#define GICC_CTLR                 0x00
+#define GICC_PMR                  0x04
+#define GICC_BPR                  0x08
+#define GICC_IAR                  0x0C
+#define GICC_EOIR                 0x10
+
+#define GICD_CTLR_ENABLEGRP1_NS   0x1
+#define GICC_CTLR_ENABLEGRP1_NS   0x1
+
+#endif /* ! _PEXPERT_ARM64_X96SC2_H */
