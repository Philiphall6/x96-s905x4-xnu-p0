+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			x96_vtimer_intid = intid;
+		}
+		void const *security_prop;
+		unsigned int security_size;
+		if (SecureDTGetProperty(entry, "x96,single-security", &security_prop,
+		    &security_size) == kSuccess) {
+			if (security_size != sizeof(uint32_t)) {
+				panic("%s: invalid x96,single-security size %u", __func__, security_size);
+			}
+			x96_gic_single_security = *(const uint32_t *)security_prop != 0;
+		}
