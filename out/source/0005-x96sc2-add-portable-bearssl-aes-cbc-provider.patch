+x96_aes_ct_enc.o_INCFLAGS = $(X96_AES_INC)
+x96_aes_ct_dec.o_INCFLAGS = $(X96_AES_INC)
+x96_aes_ct_cbcenc.o_INCFLAGS = $(X96_AES_INC)
+x96_aes_ct_cbcdec.o_INCFLAGS = $(X96_AES_INC)
+x96_aes.o_CFLAGS_ADD += -mgeneral-regs-only
+x96_aes_ct.o_CFLAGS_ADD += -mgeneral-regs-only
+x96_aes_ct_enc.o_CFLAGS_ADD += -mgeneral-regs-only
+x96_aes_ct_dec.o_CFLAGS_ADD += -mgeneral-regs-only
