@@ -19,6 +19,24 @@ include $(MakeInc_def)
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
 
+ifeq ($(CURRENT_MACHINE_CONFIG),X96SC2)
+X96_AES_ROOT = $(SRCROOT)/libkern/crypto/x96_bearssl
+X96_AES_INC = -I$(X96_AES_ROOT)/inc -I$(X96_AES_ROOT)/src
+x96_aes.o_INCFLAGS = $(X96_AES_INC)
