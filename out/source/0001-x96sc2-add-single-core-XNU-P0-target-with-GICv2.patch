+#define x96_gicd_write32(offset, value) \
+	x96_gic_write32(x96_gicd_base + (offset), (value))
+#define x96_gicc_read32(offset) \
+	x96_gic_read32(x96_gicc_base + (offset))
+#define x96_gicc_write32(offset, value) \
