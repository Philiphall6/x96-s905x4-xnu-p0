diff --git a/libkern/crypto/x96_aes.c b/libkern/crypto/x96_aes.c
new file mode 100644
index 0000000..5f366a5
--- /dev/null
+++ b/libkern/crypto/x96_aes.c
@@ -0,0 +1,106 @@
+/* Portable X96SC2 AES CBC provider using the pinned MIT-licensed BearSSL. */
+#if defined(ARM64_BOARD_CONFIG_X96SC2)
+#include <libkern/libkern.h>
+#include <libkern/crypto/aes.h>
+#include <corecrypto/ccmode.h>
+#include <corecrypto/cc_error.h>
+#include "x96_bearssl/inc/bearssl_block.h"
+
+_Static_assert(sizeof(br_aes_ct_cbcenc_keys) <= sizeof(aes_encrypt_ctx),
+    "BearSSL encryption context does not fit the XNU AES ABI");
+_Static_assert(sizeof(br_aes_ct_cbcdec_keys) <= sizeof(aes_decrypt_ctx),
+    "BearSSL decryption context does not fit the XNU AES ABI");
+
+static int
+x96_aes_encrypt_init(const struct ccmode_cbc *mode, cccbc_ctx *ctx,
+    size_t key_len, const void *key)
+{
+	(void)mode;
+	if (ctx == NULL) {
+		return CCERR_PARAMETER;
+	}
+	cc_clear(sizeof(br_aes_ct_cbcenc_keys), ctx);
+	if (key == NULL || (key_len != 16 && key_len != 24 && key_len != 32)) {
+		return CCERR_PARAMETER;
+	}
+	br_aes_ct_cbcenc_init((br_aes_ct_cbcenc_keys *)(void *)ctx, key, key_len);
+	return CCERR_OK;
+}
+
+static int
+x96_aes_decrypt_init(const struct ccmode_cbc *mode, cccbc_ctx *ctx,
+    size_t key_len, const void *key)
+{
+	(void)mode;
+	if (ctx == NULL) {
+		return CCERR_PARAMETER;
+	}
+	cc_clear(sizeof(br_aes_ct_cbcdec_keys), ctx);
+	if (key == NULL || (key_len != 16 && key_len != 24 && key_len != 32)) {
+		return CCERR_PARAMETER;
+	}
+	br_aes_ct_cbcdec_init((br_aes_ct_cbcdec_keys *)(void *)ctx, key, key_len);
+	return CCERR_OK;
+}
+
+static int
+x96_aes_validate(const void *ctx, const void *iv, size_t blocks,
+    const void *input, void *output, unsigned int rounds)
+{
+	if (ctx == NULL || iv == NULL ||
+	    (rounds != 10 && rounds != 12 && rounds != 14)) {
+		return CCERR_PARAMETER;
+	}
+	if (blocks > SIZE_MAX / 16) {
+		return CCERR_OVERFLOW;
+	}
+	if (blocks != 0 && (input == NULL || output == NULL)) {
+		return CCERR_PARAMETER;
+	}
+	return CCERR_OK;
+}
+
+static int
+x96_aes_encrypt_cbc(const cccbc_ctx *ctx, cccbc_iv *iv, size_t blocks,
+    const void *input, void *output)
+{
+	const br_aes_ct_cbcenc_keys *key = (const void *)ctx;
+	int error = x96_aes_validate(ctx, iv, blocks, input, output,
+	    key == NULL ? 0 : key->num_rounds);
+	if (error != CCERR_OK || blocks == 0) {
+		return error;
+	}
+	memmove(output, input, blocks * 16);
+	br_aes_ct_cbcenc_run(key, iv, output, blocks * 16);
+	return CCERR_OK;
+}
+
+static int
+x96_aes_decrypt_cbc(const cccbc_ctx *ctx, cccbc_iv *iv, size_t blocks,
+    const void *input, void *output)
+{
+	const br_aes_ct_cbcdec_keys *key = (const void *)ctx;
+	int error = x96_aes_validate(ctx, iv, blocks, input, output,
+	    key == NULL ? 0 : key->num_rounds);
+	if (error != CCERR_OK || blocks == 0) {
+		return error;
+	}
+	memmove(output, input, blocks * 16);
+	br_aes_ct_cbcdec_run(key, iv, output, blocks * 16);
+	return CCERR_OK;
+}
+
+const struct ccmode_cbc x96_aes_cbc_encrypt = {
+	.size = sizeof(br_aes_ct_cbcenc_keys),
+	.block_size = 16,
+	.init = x96_aes_encrypt_init,
+	.cbc = x96_aes_encrypt_cbc,
+};
+
+const struct ccmode_cbc x96_aes_cbc_decrypt = {
+	.size = sizeof(br_aes_ct_cbcdec_keys),
+	.block_size = 16,
+	.init = x96_aes_decrypt_init,
+	.cbc = x96_aes_decrypt_cbc,
+};
+#endif /* ARM64_BOARD_CONFIG_X96SC2 */
