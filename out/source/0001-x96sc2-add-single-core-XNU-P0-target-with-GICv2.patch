+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *regions = (uint64_t const *)prop;
+		x96_gicd_base = ml_io_map(soc_base_phys + regions[0], regions[1]);
+		x96_gicc_base = ml_io_map(soc_base_phys + regions[2], regions[3]);
+		if (x96_gicd_base == 0 || x96_gicc_base == 0) {
+			panic("%s: cannot map X96 GIC-400 regions", __func__);
+		}
