+	uint32_t gicc_ctlr = x96_gicc_read32(GICC_CTLR);
+	x96_gicc_write32(GICC_CTLR, gicc_ctlr | GICC_CTLR_ENABLEGRP1_NS);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
+uint32_t
+x96_gicv2_ack(void)
+{
+	return x96_gicc_read32(GICC_IAR);
+}
+
+void
+x96_gicv2_eoi(uint32_t iar)
+{
+	x96_gicc_write32(GICC_EOIR, iar);
+}
+
+void
+x96_gicv2_send_sgi(unsigned int sgi, unsigned int cpu)
+{
+	if (sgi >= 16 || cpu >= 8) {
+		panic("%s: invalid SGI %u or CPU target %u", __func__, sgi, cpu);
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	x96_gicd_write32(GICD_SGIR, (1U << (cpu + 16)) | sgi);
+	__builtin_arm_isb(ISB_SY);
 }
